{
  "name": "llmman-mobile",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.0",
    "expo-build-properties": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-image-manipulator": "~58.0.0",
    "expo-image-picker": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-media-library": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-video": "~58.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.0.0",
    "eslint-config-expo": "~58.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "jest": "~30.5.0",
    "jest-expo": "~58.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~7.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "node scripts/make-icons.mjs --if-missing",
    "make-icons": "node scripts/make-icons.mjs",
    "make-web-icons": "node scripts/make-web-icons.mjs",
    "export-web": "node scripts/export-web.mjs",
    "vendor-xterm": "node scripts/vendor-xterm.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
