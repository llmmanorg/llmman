{
  "schema": 1,
  "description": "Pinned inputs for the pre-baked e2e environment.",
  "base": {
    "linux": {
      "image": "ubuntu:24.04",
      "platforms": ["linux/amd64", "linux/arm64"]
    }
  },
  "toolchains": {"mise": "../../../.mise.toml"},
  "release_files": {
    "llama_cpp": "../../../LLAMA_CPP_RELEASE",
    "mlx_lm": "../../../MLX_LM_RELEASE",
    "python": "../../../PYTHON_RELEASE"
  },
  "npm": [
    {"name": "@oh-my-pi/pi-coding-agent", "version": "18.2.11", "binary": "omp", "installer": "bun"},
    {"name": "@anthropic-ai/claude-code", "version": "2.1.283", "binary": "claude", "installer": "npm"},
    {"name": "opencode-ai", "version": "1.18.33", "binary": "opencode", "installer": "npm"},
    {"name": "@openai/codex", "version": "0.157.1", "binary": "codex", "installer": "npm"},
    {"name": "cline", "version": "2.18.0", "binary": "cline", "installer": "npm"},
    {"name": "@earendil-works/pi-coding-agent", "version": "0.86.1", "binary": "pi", "installer": "npm"},
    {"name": "@qwen-code/qwen-code", "version": "0.22.3", "binary": "qwen", "installer": "npm"},
    {"name": "openclaw", "version": "2026.7.1-2", "binary": "openclaw", "installer": "npm"},
    {"name": "@deepseek-ai/dsh", "version": "0.1.2-rc.1", "binary": "dsh", "installer": "npm"}
  ],
  "native_tools": {
    "goose": {"version": "1.50.0", "source": "https://github.com/aaif-goose/goose/releases"},
    "grok": {"version": "1.0.34", "source": "https://x.ai/cli/install.sh"},
    "docker_agent": {"version": "1.142.0", "source": "https://github.com/docker/docker-agent/releases"},
    "muse": {"version": "1.4.0-R4302.1", "source": "https://lookaside.facebook.com/lookaside/muse/download/"},
    "agy": {"version": "1.2.2", "source": "https://github.com/google-antigravity/antigravity-cli/releases"},
    "hermes": {"version": "v2026.9.21", "source": "https://github.com/NousResearch/hermes-agent/releases"}
  },
  "engines": {
    "llama_cpp": {"version_file": "../../../LLAMA_CPP_RELEASE"},
    "vllm": {"version": "0.30.0"},
    "vllm_metal": {"version": "0.30.0"},
    "sglang": {"version": "0.5.19"},
    "mlx_lm": {"version_file": "../../../MLX_LM_RELEASE"}
  },
  "linux_packages": [
    "ca-certificates",
    "cmake",
    "curl",
    "g++",
    "gcc",
    "git",
    "libcurl4",
    "libgomp1",
    "libnuma-dev",
    "ninja-build",
    "pkg-config",
    "unzip",
    "xz-utils"
  ]
}
